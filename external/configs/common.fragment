BR2_INIT_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY_PORT="console"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_INITRAMFS=y
BR2_TARGET_ROOTFS_EXT2=n
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_WIRELESS_LAB_PATH)/board/common/overlay"
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# Latest mainline kernel straight from Linus's tree (ref set by the Makefile)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="master"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_WIRELESS_LAB_PATH)/board/common/linux-wireless.fragment"
# Latest userspace stack: git HEAD overrides in external/local.mk
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_WIRELESS_LAB_PATH)/local.mk"
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_LIBNL=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
